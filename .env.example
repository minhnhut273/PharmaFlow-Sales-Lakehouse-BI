# ==============================================================================
# PharmaFlow Sales & Weather Lakehouse (BI Pipeline) - Environment Variables
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit `.env` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Upstream Relational Source: Neon PostgreSQL (pharmaflow_source_postgre_v2)
# ------------------------------------------------------------------------------
# Direct unpooled connection string (owner/loader role for bootstrap & verification)
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

# Read-only SELECT connection string for Weather Ingestion (weather_reader role)
WEATHER_NEON_DSN=postgresql://weather_reader:<password>@<neon-host>/pharmaflow_source_postgre_v2?sslmode=require

# ------------------------------------------------------------------------------
# 2. Upstream Document Source: MongoDB Atlas (pharmaflow_product_knowledge)
# ------------------------------------------------------------------------------
USERNAME_MONGODB=<mongodb_username>
PASSWORD_MONGODB=<mongodb_password>
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AWS S3 & Weather Ingestion (ap-southeast-1)
# ------------------------------------------------------------------------------
WEATHER_S3_BUCKET=pharmaflow-dev-weather-raw-<account-id>-ap-southeast-1
WEATHER_S3_REGION=ap-southeast-1
WEATHER_S3_ROLE_ARN=arn:aws:iam::<account-id>:role/pharmaflow-dev-weather-local-writer
WEATHER_AWS_PROFILE=my-aws

# ------------------------------------------------------------------------------
# 4. Databricks Free Edition / Workspace (Unity Catalog: pharmaflow_dev)
# ------------------------------------------------------------------------------
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. BI Serving Layer: Neon BI Mirror for AWS QuickSight & Streamlit (landing_datamart_md01)
#    * Member ONLY running the Streamlit BI Dashboard (`src/streamlit/app.py`) ONLY needs
#      the 2 variables below! Prefer sharing a SELECT-only Neon role (e.g. bi_reader) on quick_gold_md01.
# ------------------------------------------------------------------------------
QUICK_NEON_DATABASE_URL=postgresql://<user>:<password>@<neon-pooler-host>/neondb?sslmode=require
QUICK_NEON_SCHEMA=quick_gold_md01
